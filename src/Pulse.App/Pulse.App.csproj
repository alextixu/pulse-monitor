<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net9.0-windows: the UI needs no WinRT projection (that stays with the agent's providers). -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- The popover client of the resident agent (Pulse.exe); folder and namespaces keep the old Pulse.App name. -->
    <AssemblyName>Pulse.UI</AssemblyName>
    <RootNamespace>Pulse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Every popover open is a cold start (the UI exits when the popover hides): precompile for a fast first frame. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Description>Pulse popover: battery, telemetry, fan and RGB panels shown by the Pulse agent's tray icon.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Moved to the agent (Pulse.Agent copies it); kept here until that copy exists, but no longer part of the UI. -->
    <Compile Remove="Services\SingleInstance.cs" />
    <None Include="Services\SingleInstance.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.20" />
    <!-- Mutex / event ACLs of the single-instance guard (came in via Pulse.Hardware before). Same version as the agent's
         LibreHardwareMonitor dependency, since both executables are published into one folder. -->
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Core\Pulse.Core.csproj" />
    <!-- Only for the in-process demo / screenshot agent and the file logger; the real engine runs in Pulse.exe. -->
    <ProjectReference Include="..\Pulse.Engine\Pulse.Engine.csproj" />
  </ItemGroup>

</Project>
