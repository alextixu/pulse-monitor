<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pulse.App.ViewModels"
             xmlns:loc="using:Pulse.App.Localization"
             xmlns:conv="using:Pulse.App.Converters"
             xmlns:controls="using:Pulse.App.Controls"
             x:Class="Pulse.App.Views.SystemView"
             x:DataType="vm:SystemViewModel">

    <StackPanel Spacing="12">

        <!-- Not elevated: slim amber banner with the "run as administrator" pill -->
        <Border Classes="banner warning" IsVisible="{Binding ShowElevationBanner}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource IconShield}" Width="16" Height="16" Margin="0,0,10,0"
                          Foreground="{DynamicResource BccWarningBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="{x:Static loc:Strings.SystemElevateBanner}" />
                <Button Grid.Column="2" Classes="pill" Padding="12,6" MinHeight="30" VerticalAlignment="Center"
                        Command="{Binding ElevateCommand}" Content="{x:Static loc:Strings.ElevateShort}" />
            </Grid>
        </Border>

        <!-- Hardware status hint -->
        <Border Classes="banner" IsVisible="{Binding HasHardwareMessage}">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" Width="15" Height="15" Margin="0,1,10,0"
                          Foreground="{DynamicResource BccAccentBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding HardwareMessage}" />
            </Grid>
        </Border>

        <!-- Waiting for the first snapshot -->
        <Border Classes="card" MinHeight="200" IsVisible="{Binding !HasData}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <Border Classes="tile" Width="60" Height="60" CornerRadius="18" Background="{DynamicResource BccPurpleTintBrush}">
                    <PathIcon Data="{StaticResource IconCpu}" Width="28" Height="28" Foreground="{DynamicResource BccPurpleBrush}" />
                </Border>
                <TextBlock Classes="caption" TextAlignment="Center" Text="{x:Static loc:Strings.HardwareNotReady}" />
            </StackPanel>
        </Border>

        <!-- CPU -->
        <Border Classes="card" IsVisible="{Binding HasCpu}">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="tile" Background="{DynamicResource BccPurpleTintBrush}">
                        <PathIcon Data="{StaticResource IconCpu}" Width="22" Height="22" Foreground="{DynamicResource BccPurpleBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.Cpu}" />
                        <TextBlock Classes="title" TextWrapping="Wrap" MaxLines="2" LineHeight="19" TextTrimming="CharacterEllipsis" Text="{Binding CpuName}" ToolTip.Tip="{Binding CpuName}" />
                    </StackPanel>
                    <controls:StatPill Grid.Column="2" VerticalAlignment="Center" Icon="{StaticResource IconThermometer}"
                                       Tone="{Binding CpuTempTone}" Text="{Binding CpuTempText}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <controls:RingGauge Grid.Column="0" Width="96" Height="96" Thickness="9" ColorMode="Load" Value="{Binding CpuLoad}" VerticalAlignment="Center">
                        <StackPanel Spacing="0">
                            <TextBlock FontSize="21" FontWeight="Bold" TextWrapping="NoWrap" HorizontalAlignment="Center" Text="{Binding CpuLoadText}" />
                            <TextBlock Classes="caption" FontSize="10" HorizontalAlignment="Center" Text="{x:Static loc:Strings.Load}" />
                        </StackPanel>
                    </controls:RingGauge>

                    <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Margin="0,0,14,0" VerticalAlignment="Center" Text="{x:Static loc:Strings.Temperature}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="value-sm" TextWrapping="NoWrap" Text="{Binding CpuTempText}"
                                       Foreground="{Binding CpuTempTone, Converter={x:Static conv:ToneToBrushConverter.Instance}}" />
                            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static loc:Strings.NeedsAdmin}" IsVisible="{Binding CpuTempUnavailable}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Margin="0,8,14,0" VerticalAlignment="Center" Text="{x:Static loc:Strings.Clock}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="value-sm" Margin="0,8,0,0" TextWrapping="NoWrap" Text="{Binding CpuClockText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Margin="0,8,14,0" VerticalAlignment="Center" Text="{x:Static loc:Strings.Power}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="value-sm" Margin="0,8,0,0" TextWrapping="NoWrap" Text="{Binding CpuPowerText}" />
                    </Grid>
                </Grid>

                <!-- Per-core load bars -->
                <StackPanel Spacing="6" IsVisible="{Binding HasCores}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.CoreLoads}" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CoreCountText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CoreLoads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoreLoadItem">
                                <Border Width="12" Height="30" CornerRadius="4" Background="{DynamicResource BccTrackBrush}" ClipToBounds="True"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <Border VerticalAlignment="Bottom" CornerRadius="4" MinHeight="2"
                                            Height="{Binding Load, Converter={x:Static conv:PercentToWidthConverter.Instance}, ConverterParameter=width:30}"
                                            Background="{Binding Tone, Converter={x:Static conv:ToneToBrushConverter.Instance}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- GPUs -->
        <ItemsControl ItemsSource="{Binding Gpus}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GpuItemViewModel">
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="tile" Background="{DynamicResource BccTealTintBrush}">
                                    <PathIcon Data="{StaticResource IconGpu}" Width="22" Height="22" Foreground="{DynamicResource BccTealBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="caption" Text="{Binding VendorText}" />
                                    <TextBlock Classes="title" TextWrapping="Wrap" MaxLines="2" LineHeight="19" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                </StackPanel>
                                <controls:StatPill Grid.Column="2" VerticalAlignment="Center" Icon="{StaticResource IconThermometer}"
                                                   Tone="{Binding TempTone}" Text="{Binding TempText}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <controls:RingGauge Grid.Column="0" Width="80" Height="80" Thickness="8" ColorMode="Load" Value="{Binding Load}" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="NoWrap" HorizontalAlignment="Center" Text="{Binding LoadText}" />
                                        <TextBlock Classes="caption" FontSize="9.5" HorizontalAlignment="Center" Text="{x:Static loc:Strings.Load}" />
                                    </StackPanel>
                                </controls:RingGauge>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="8">
                                    <StackPanel Spacing="5" IsVisible="{Binding HasVram}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="caption" Text="{x:Static loc:Strings.VideoMemory}" />
                                            <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource BccTextPrimaryBrush}" Text="{Binding VramText}" />
                                        </Grid>
                                        <ProgressBar Classes="rounded" Minimum="0" Maximum="100" Value="{Binding VramPercent}" Foreground="{DynamicResource BccTealBrush}" />
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
                                        <controls:StatPill Icon="{StaticResource IconFan}" Tone="Accent" Text="{Binding FanText}" IsVisible="{Binding HasFan}" />
                                        <controls:StatPill Tone="{Binding HotSpotTone}" Text="{Binding HotSpotText}" IsVisible="{Binding HasHotSpot}" />
                                        <controls:StatPill Icon="{StaticResource IconBolt}" Tone="Neutral" Text="{Binding PowerText}" IsVisible="{Binding HasPower}" />
                                        <controls:StatPill Tone="Neutral" Text="{Binding ClockText}" IsVisible="{Binding HasClock}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Memory -->
        <Border Classes="card" IsVisible="{Binding HasMemory}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="tile" Background="{DynamicResource BccAccentTintBrush}">
                        <PathIcon Data="{StaticResource IconMemory}" Width="22" Height="22" Foreground="{DynamicResource BccAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.Memory}" />
                        <TextBlock Classes="value-sm" TextWrapping="NoWrap" Text="{Binding MemoryText}" />
                    </StackPanel>
                    <controls:StatPill Grid.Column="2" VerticalAlignment="Center" Tone="Accent" Text="{Binding MemoryPercentText}" />
                </Grid>
                <ProgressBar Classes="rounded" Minimum="0" Maximum="100" Value="{Binding MemoryPercent}" />
            </StackPanel>
        </Border>

        <!-- Drives -->
        <ItemsControl ItemsSource="{Binding Storages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageItemViewModel">
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="tile" Background="{DynamicResource BccPurpleTintBrush}">
                                    <PathIcon Data="{StaticResource IconStorage}" Width="22" Height="22" Foreground="{DynamicResource BccPurpleBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="caption" Text="{Binding KindText}" />
                                    <TextBlock Classes="title" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                </StackPanel>
                                <controls:StatPill Grid.Column="2" VerticalAlignment="Center" Icon="{StaticResource IconThermometer}"
                                                   Tone="{Binding TempTone}" Text="{Binding TempText}" IsVisible="{Binding HasTemp}" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowDetails}">
                                <controls:RingGauge Grid.Column="0" Width="80" Height="80" Thickness="8" ColorMode="Load" Value="{Binding UsedSpace}"
                                                    VerticalAlignment="Center" IsVisible="{Binding HasUsedSpace}">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="NoWrap" HorizontalAlignment="Center" Text="{Binding UsedSpaceText}" />
                                        <TextBlock Classes="caption" FontSize="9.5" HorizontalAlignment="Center" Text="{x:Static loc:Strings.UsedSpace}" />
                                    </StackPanel>
                                </controls:RingGauge>

                                <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
                                    <controls:StatPill Tone="Accent" Text="{Binding ReadText}" IsVisible="{Binding HasRates}" />
                                    <controls:StatPill Tone="Purple" Text="{Binding WriteText}" IsVisible="{Binding HasRates}" />
                                    <controls:StatPill Tone="{Binding LifeTone}" Text="{Binding LifeText}" IsVisible="{Binding HasLife}" />
                                    <controls:StatPill Tone="Neutral" Text="{Binding WrittenText}" IsVisible="{Binding HasWritten}" />
                                </WrapPanel>
                            </Grid>

                            <TextBlock Classes="caption" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Other temperatures -->
        <Expander Classes="card" IsVisible="{Binding HasOtherTemperatures}" IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconThermometer}" Width="15" Height="15" Foreground="{DynamicResource BccWarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="title" Text="{Binding OtherTemperaturesHeader}" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding OtherTemperatures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemperatureItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" Height="30">
                            <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <Border Grid.Column="1" Classes="chip" Margin="8,0">
                                <TextBlock Text="{Binding Group}" />
                            </Border>
                            <TextBlock Grid.Column="2" Classes="value-sm" FontSize="14" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"
                                       Text="{Binding ValueText}" Foreground="{Binding Tone, Converter={x:Static conv:ToneToBrushConverter.Instance}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </StackPanel>
</UserControl>
